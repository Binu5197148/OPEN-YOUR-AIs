{
  "buildCommand": "",
  "framework": null,
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/article/:slug", "destination": "/blog/:slug", "permanent": true },
    { "source": "/blog/claude-cowork-tutorial-autonomous-task-execution-2026", "destination": "/blog", "permanent": true },
    { "source": "/:path*", "destination": "https://www.openyourais.com/:path*", "permanent": true, "has": [{ "type": "host", "value": "open-your-a-61c2cuinw-open-your-ai-s.vercel.app" }] }
  ],
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/ads.txt", "destination": "/ads.txt" },
    { "source": "/ulisses-balbino.jpg", "destination": "/ulisses-balbino.jpg" },
    { "source": "/logo.svg", "destination": "/logo.svg" },
    { "source": "/og-default.svg", "destination": "/og-default.svg" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
